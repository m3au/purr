#!/bin/sh
# Main purr script

# Set SOURCING flag when being sourced
SOURCING=1

# Set up environment
PURR_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PURR_LIB="${PURR_ROOT}/lib"
export PURR_ROOT PURR_LIB

# Source core modules
. "$PURR_ROOT/lib/modules/core/common.sh"
. "$PURR_ROOT/lib/modules/core/color.sh"
. "$PURR_ROOT/lib/modules/core/env.sh"
. "$PURR_ROOT/lib/modules/core/auth.sh"
. "$PURR_ROOT/lib/modules/core/git.sh"
. "$PURR_ROOT/lib/modules/core/ssh.sh"
. "$PURR_ROOT/lib/modules/core/gpg.sh"
. "$PURR_ROOT/lib/modules/core/config.sh"

# Source command modules
. "$PURR_ROOT/lib/modules/commands/status/status.sh"
. "$PURR_ROOT/lib/modules/commands/system/lock.sh"
. "$PURR_ROOT/lib/modules/commands/system/install.sh"
. "$PURR_ROOT/lib/modules/commands/system/uninstall.sh"
. "$PURR_ROOT/lib/modules/commands/system/update.sh"
. "$PURR_ROOT/lib/modules/commands/system/verify.sh"
. "$PURR_ROOT/lib/modules/commands/system/version.sh"
. "$PURR_ROOT/lib/modules/commands/system/doctor.sh"
. "$PURR_ROOT/lib/modules/commands/config/config.sh"
. "$PURR_ROOT/lib/modules/commands/config/backup.sh"
. "$PURR_ROOT/lib/modules/commands/config/reset.sh"
. "$PURR_ROOT/lib/modules/commands/keys/keys.sh"

# Load shell completions when being sourced
if [ "$SOURCING" = "1" ]; then
  . "$PURR_ROOT/scripts/completion.sh"
fi

main() {
  # Only run main if not being sourced
  if [ "$SOURCING" != "1" ]; then
    case "${1:-}" in
    status)
      shift
      status_command "$@"
      ;;
    keys)
      shift
      keys_command "$@"
      ;;
    lock)
      shift
      lock_command "$@"
      ;;
    install)
      shift
      install_command "$@"
      ;;
    uninstall)
      shift
      uninstall_command "$@"
      ;;
    update)
      shift
      update_command "$@"
      ;;
    doctor)
      shift
      doctor_command "$@"
      ;;
    config)
      shift
      config_command "$@"
      ;;
    backup)
      shift
      backup_command "$@"
      ;;
    reset)
      shift
      reset_command "$@"
      ;;
    verify)
      shift
      verify_command "$@"
      ;;
    version)
      shift
      version_command "$@"
      ;;
    *)
      if [ -n "${1:-}" ]; then
        printf "Unknown command: %s\n" "$1"
        help_command
        exit 1
      fi
      # Default behavior when no command specified
      status_command
      ;;
    esac
  fi
}

main "$@"

# Unset SOURCING flag after initialization
unset SOURCING
