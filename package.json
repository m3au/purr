{
  "name": "@m3au/purr",
  "version": "0.0.1",
  "description": "Key management that integrates 1Password, SSH, and GPG. Securely loads and unloads keys, configures Git signing, and manages GitHub credentials - all with a simple purr command.",
  "author": {
    "name": "m3au",
    "email": "m3au@pm.me"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m3au/purr.git"
  },
  "bin": {
    "purr": "lib/purr"
  },
  "scripts": {
    "test": "shellspec tests/*.spec",
    "coverage": "rm -rf coverage && ulimit -n 4096 && shellspec --kcov tests/*.spec",
    "lint": "shellcheck -x lib/**/*.sh",
    "fix": "shfmt -i 2 -ci -sr -w lib/**/*.sh",
    "format": "prettier --write '*.{json,md}'",
    "precommit": "bun run lint && shellcheck -x lib/**/*.sh",
    "clean": "bun x delete-empty && git clean -fXd",
    "man": "md2man-roff docs/purr.1.md > docs/purr.1",
    "install": "purr install",
    "uninstall": "purr uninstall"
  },
  "devDependencies": {
    "prettier": "3.2.5"
  },
  "private": true
}
